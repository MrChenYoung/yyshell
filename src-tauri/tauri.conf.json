{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YYShell",
  "version": "1.0.12",
  "identifier": "com.chenhuiyi.yyshell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YYShell",
        "width": 1600,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0M0YxQ0I5QzBERDlCMTEKUldRUm05M0F1UncvbEw0NDJ2aFFIRlpzbzZWYW1VMEQxNnBMa0VFL0hXM1N2TUdneTlRQ1BlcTgK",
      "endpoints": [
        "https://github.com/mrchenyoung/yyshell/releases/latest/download/latest.json"
      ]
    }
  }
}
